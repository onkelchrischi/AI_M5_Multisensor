{
  "schema_version": 2,
  "name": "ST25DV16 Speicher",
  "sensor_type": "ST25DV16",
  "group": "NFC / Speicher",
  "interface": {
    "type": "i2c",
    "address": 83,
    "register_bytes": 2
  },
  "interval_ms": 1000,
  "constants": {},
  "sequences": {
    "detect": [
      {
        "op": "read",
        "reg": 0,
        "bytes": 1,
        "var": "probe"
      }
    ],
    "init": [],
    "measure": [
      {
        "op": "read",
        "reg": 0,
        "bytes": 4,
        "var": "word0"
      },
      {
        "op": "read",
        "reg": 4,
        "bytes": 4,
        "var": "word1"
      }
    ],
    "stop": []
  },
  "outputs": [
    {
      "var": "word0",
      "label": "EEPROM 0..3",
      "unit": "raw"
    },
    {
      "var": "word1",
      "label": "EEPROM 4..7",
      "unit": "raw"
    }
  ],
  "notes": "Nur lesender EEPROM-Zugriff. Keine eindeutige Modellidentifikation; andere Speicher auf 0x53 koennen ebenfalls antworten. Keine RF-Konfiguration, keine Schreibzugriffe. Hardwaretest ausstehend."
}
